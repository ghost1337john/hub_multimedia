# === Hub Multimédia — Fichier d'environnement ===
# Copie ce fichier en .env et renseigne tes valeurs.
# Ne jamais commiter le .env avec des vraies valeurs.

# --- Utilisateur système ---
PUID=1000
PGID=1000
TZ=Europe/Paris

# --- Stockage ---
MEDIA_DIR=/data

# --- ProtonVPN (OpenVPN) ---
# Ajouter +pmp à la fin du username pour le port forwarding
OPENVPN_USER=ton_user+pmp
OPENVPN_PASSWORD=ton_password

# --- ProtonVPN (WireGuard) ---
WIREGUARD_PRIVATE_KEY=ta_cle_privee_wireguard

# --- Pays VPN ---
SERVER_COUNTRIES=Spain,Portugal
